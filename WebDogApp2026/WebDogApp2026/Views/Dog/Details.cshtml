@model WebDogApp2026.Models.Dog.DetailsVM

@{
    ViewData["Title"] = "Details";
}

<h1>Dog Details</h1>

<div>
    <h4>DogDetailsViewModel</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Age)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Age)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.BreedName)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.BreedName)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Picture)
        </dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.Picture))
            {
                <img src="@Model.Picture"
                     alt="@Model.Name"
                     width="100" />
            }
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit"
       asp-controller="Dog"
       asp-route-id="@Model.Id">Edit</a> |

    <a asp-action="Index"
       asp-controller="Dog">Back to List</a>
</div>
